# Copy to .env and fill in. Never commit .env or your service-account key.

# --- Google Cloud ---
# Both are auto-detected from a service-account JSON placed in the project root.
# Set them only to override that.
# PROJECT_ID=your-gcp-project
REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# --- Gemini: pick ONE ---
# (a) AI Studio key — simplest.  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (b) Vertex AI using the service account — no key needed.
#     Requires aiplatform.googleapis.com enabled + roles/aiplatform.user.
USE_VERTEX=false

# gemini-2.5-flash is retired for API keys created after Google's cutoff and
# returns 404 for them. Leave this on the current Flash generation unless your
# key has access to something newer.
# flash-lite has the highest free-tier request limit and answers in ~2s.
# Do NOT use a *-live-* model here: those speak the bidirectional Live API over
# a WebSocket and do not support generateContent.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2

# --- ACCESS CONTROL ---
# Required. There is no unauthenticated mode; without this every request is
# refused (locally a token is generated and printed at startup instead).
DASHBOARD_TOKEN=
# Separate credential for Cloud Scheduler, so a leaked scheduler token cannot
# press the approval buttons. Falls back to DASHBOARD_TOKEN when empty.
WEBHOOK_TOKEN=

# --- SECOND-TIER MODEL ---
# Gemma answers when Gemini does not. Same API, same SDK — a model name, not a
# second integration. It is given the narrow job of summarising the fleet:
# measured against a six-service estate it cannot return the analyst's
# per-resource schema inside a usable deadline, but summarises the same fleet in
# about twenty seconds. Empty disables the tier.
GEMMA_MODEL=gemma-4-31b-it

# --- OUTBOUND NOTIFICATIONS ---
# The agent runs hourly while nobody is watching. A ticket nobody is told about
# is a human-in-the-loop that depends on someone opening a dashboard. Every
# channel is optional; unset means that channel is skipped, not an error.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Link back into the deck from a notification. On Cloud Run, the service URL.
DASHBOARD_URL=

# --- OBSERVABILITY ---
# OpenTelemetry spans → Cloud Trace. Needs roles/cloudtrace.agent on the
# service account; without it the agent runs and reports the gap once.
OTEL_ENABLED=true

# --- SAFETY GATE ---
# While true, remediation tools compute and log the change but never touch live
# infrastructure. Flip to false ONLY when you want the agent to really resize
# Cloud Run services. Requires roles/run.admin.
DRY_RUN=true

# --- Metrics ---
# Pull real CPU/memory utilization from Cloud Monitoring (roles/monitoring.viewer).
# Falls back to a deterministic model when unavailable.
USE_REAL_METRICS=true
METRICS_LOOKBACK_HOURS=24
METRICS_CACHE_TTL=60

# --- Agent behaviour ---
MEMORY_ANOMALY_THRESHOLD_GIB=1.0
HIGH_RISK_ROI_THRESHOLD=40.0
STATE_FILE=data/memory_bank.json

# Run entirely on simulated infrastructure (no GCP calls at all).
MOCK_MODE=false

# Automatic function calls per audit. Each is a separate API request and the
# Gemini free tier allows only 5/minute. Raise this on a paid tier.
MAX_TOOL_CALLS=4

# Regions to scan for Cloud Run services. "auto" probes the common regions in
# parallel; or give a comma-separated list to narrow it.
SCAN_REGIONS=auto

# Substitute the demo fleet when a GCP call fails. Off by default so a real
# deployment never silently displays invented infrastructure.
ALLOW_SIMULATED_FALLBACK=false
